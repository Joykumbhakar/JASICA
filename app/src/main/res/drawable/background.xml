<?xml version="1.0" encoding="utf-8"?>
<!-- Place this in res/drawable/background.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base deep-space dark -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#080818"/>
        </shape>
    </item>

    <!-- Top-left blue aurora -->
    <item
        android:top="-120dp"
        android:left="-120dp"
        android:right="200dp"
        android:bottom="400dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:startColor="#55007AFF"
                android:endColor="#00007AFF"
                android:gradientRadius="50%p"/>
        </shape>
    </item>

    <!-- Center-right purple nebula -->
    <item
        android:top="100dp"
        android:left="150dp"
        android:right="-80dp"
        android:bottom="300dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:startColor="#44AF52DE"
                android:endColor="#00AF52DE"
                android:gradientRadius="50%p"/>
        </shape>
    </item>

    <!-- Bottom teal glow -->
    <item
        android:top="400dp"
        android:left="-80dp"
        android:right="200dp"
        android:bottom="-80dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:startColor="#335AC8FA"
                android:endColor="#005AC8FA"
                android:gradientRadius="50%p"/>
        </shape>
    </item>

    <!-- Subtle overall darkening vignette overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:startColor="#00000000"
                android:endColor="#AA000000"
                android:gradientRadius="75%p"
                android:centerX="0.5"
                android:centerY="0.5"/>
        </shape>
    </item>

</layer-list>